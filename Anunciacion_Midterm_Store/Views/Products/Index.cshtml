@model List<Product>

<div class="bg-dark text-white rounded p-4 mb-4 mt-3 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-1">Latest Tech</h2>
        <p class="mb-0 text-white-50">GPU's, CPU's, PSU's, and more</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
</div>

<form asp-action="Index" method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
           class="form-control w-auto" placeholder="Search products" />
    <button type="submit" class="btn btn-secondary">Search</button>
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No products yet. Add one to get started.</p>
}

<div class="row">
    @foreach (Product p in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">@p.Category</span>
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text text-muted">@p.Description</p>
                    <p class="fs-4 fw-bold text-primary mb-0">₱@p.Price.ToString("N2")</p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Add to Cart</button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-warning btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                          onsubmit="return confirm('Delete this product?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>