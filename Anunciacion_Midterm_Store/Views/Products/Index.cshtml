@model List<Product>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Products</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No products yet. Add one to get started.</p>
}

<div class="row">
    @foreach (Product p in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@p.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@p.Category</h6>
                    <p class="card-text">@p.Description</p>
                    <p class="fw-bold">₱@p.Price.ToString("N2")</p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Add to Cart</button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-warning btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                          onsubmit="return confirm('Delete this product?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>